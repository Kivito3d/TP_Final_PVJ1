        },
        {
            "m_Id": "c8c2589812345065b422fb70b8ab329c"
        },
        {
            "m_Id": "8060654c475d59fa8f19dceaf2f03417"
        },
        {
            "m_Id": "bb16993e79655350ad498bfd34b93f51"
        },
        {
            "m_Id": "d0500082e06a57ba885cac2ada7a3a6d"
        }
    ],
    "synonyms": [],
    "m_Precision": 1,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "RSG_CandleBillboard",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": false,
    "m_FunctionBody": "// All frequencies are multiples of 0.1; their common period is 20*pi.\n// Bound arguments for stable vertex/fragment trig during long editor sessions.\nfloat t = fmod(Time * Speed + dot(Origin, float3(2.17,0.73,3.11)), 62.83185307);\nfloat h = saturate((UV.y - 0.035) / 0.865);\nfloat sway = Sway * (sin(t*2.3) + 0.38*sin(t*5.7+1.2));\nfloat stretch = 1 + HeightFlicker*(0.65*sin(t*8.3)+0.35*sin(t*13.7));\n// Shader Graph Transform nodes supply view directions in object space without normalization.\nOut = RightOS*(Position.x+sway*0.08*h*h)*Scale.x + UpOS*(Position.y*stretch)*Scale.y;\n"
}

