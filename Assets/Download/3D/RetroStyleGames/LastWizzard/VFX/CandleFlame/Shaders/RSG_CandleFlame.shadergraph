        },
        {
            "m_Id": "0065ec89f329567b84375a9c4f62a8ea"
        },
        {
            "m_Id": "39d5088d874852acb20d4b1cf9777b8d"
        },
        {
            "m_Id": "bdf4f6944efa549d93b250757277c822"
        },
        {
            "m_Id": "92fadd2cceb95118bb901a4fc7851a53"
        }
    ],
    "synonyms": [],
    "m_Precision": 1,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "RSG_CandleSurface",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": false,
    "m_FunctionBody": "// All frequencies are multiples of 0.1; their common period is 20*pi.\n// Bound arguments for stable vertex/fragment trig during long editor sessions.\nfloat t = fmod(Time * Speed + dot(Origin, float3(2.17,0.73,3.11)), 62.83185307);\nfloat2 uv = UV;\nfloat h = saturate(uv.y);\nuv.x += Distortion*h*h*(sin(h*12-t*5.1)+0.4*sin(h*21-t*7.7));\nfloat4 flame = SAMPLE_TEXTURE2D(Flame.tex, Flame.samplerstate, uv);\nfloat mask = smoothstep(0.0,0.04,uv.x)*(1-smoothstep(0.96,1.0,uv.x));\nmask *= smoothstep(0.0,0.016,uv.y)*(1-smoothstep(0.96,1.0,uv.y));\nfloat flicker = 1 + Flicker*(0.6*sin(t*11.9)+0.4*sin(t*19.3+1));\nColor = flame.rgb*Tint.rgb*Intensity*flicker;\nAlpha = flame.a*Tint.a*mask;\n"
}
